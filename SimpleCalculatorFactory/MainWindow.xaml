<Window x:Class="SimpleCalculatorFactory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Calculator Factory"
        Height="500"
        Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F2F4F8">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Блок отображения выражения и результата -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Верхняя строка выражения -->
                <TextBlock x:Name="ExpressionDisplay"
                           Grid.Row="0"
                           Text=""
                           FontSize="16"
                           Foreground="Gray"
                           TextAlignment="Right"/>

                <!-- Основное поле результата -->
                <TextBox x:Name="Display"
                         Grid.Row="1"
                         Text="0"
                         FontSize="32"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         TextAlignment="Right"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Сетка кнопок -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Content="CE" Grid.Row="0" Grid.Column="0" Click="Button_Click"/>
            <Button Content="C" Grid.Row="0" Grid.Column="1" Click="Button_Click"/>
            <Button Content="←" Grid.Row="0" Grid.Column="2" Click="Button_Click"/>
            <Button Content="÷" Grid.Row="0" Grid.Column="3" Click="Button_Click"/>

            <Button Content="7" Grid.Row="1" Grid.Column="0" Click="Button_Click"/>
            <Button Content="8" Grid.Row="1" Grid.Column="1" Click="Button_Click"/>
            <Button Content="9" Grid.Row="1" Grid.Column="2" Click="Button_Click"/>
            <Button Content="×" Grid.Row="1" Grid.Column="3" Click="Button_Click"/>

            <Button Content="4" Grid.Row="2" Grid.Column="0" Click="Button_Click"/>
            <Button Content="5" Grid.Row="2" Grid.Column="1" Click="Button_Click"/>
            <Button Content="6" Grid.Row="2" Grid.Column="2" Click="Button_Click"/>
            <Button Content="-" Grid.Row="2" Grid.Column="3" Click="Button_Click"/>

            <Button Content="1" Grid.Row="3" Grid.Column="0" Click="Button_Click"/>
            <Button Content="2" Grid.Row="3" Grid.Column="1" Click="Button_Click"/>
            <Button Content="3" Grid.Row="3" Grid.Column="2" Click="Button_Click"/>
            <Button Content="+" Grid.Row="3" Grid.Column="3" Click="Button_Click"/>

            <Button Content="±" Grid.Row="4" Grid.Column="0" Click="Button_Click"/>
            <Button Content="0" Grid.Row="4" Grid.Column="1" Click="Button_Click"/>
            <Button Content="," Grid.Row="4" Grid.Column="2" Click="Button_Click"/>
            <Button Content="=" Grid.Row="4" Grid.Column="3" Click="Button_Click"/>
        </Grid>
    </Grid>
</Window>
