<Window x:Class="SimpleCalculatorMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Calculator MVVM"
        Height="560"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F2F4F8">

    <!-- Стили кнопок -->
    <Window.Resources>

        <!-- Общий стиль -->
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Цифры -->
        <Style x:Key="DigitButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D9D9D9"/>
        </Style>

        <!-- Операции -->
        <Style x:Key="OperatorButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFB74D"/>
        </Style>

        <!-- Память -->
        <Style x:Key="MemoryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#90CAF9"/>
        </Style>

        <!-- Очистка -->
        <Style x:Key="ClearButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EF9A9A"/>
        </Style>

        <!-- Спец функции -->
        <Style x:Key="SpecialButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#80DEEA"/>
        </Style>

        <!-- Равно -->
        <Style x:Key="EqualsButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#81C784"/>
        </Style>

    </Window.Resources>

    <!-- Основная сетка -->
    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Дисплей -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,15">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Выражение -->
                <TextBlock Grid.Row="0"
                           Text="{Binding ExpressionDisplay}"
                           FontSize="16"
                           Foreground="Gray"
                           TextAlignment="Right"/>

                <!-- Основной дисплей -->
                <TextBox Grid.Row="1"
                         Text="{Binding Display}"
                         FontSize="34"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         TextAlignment="Right"
                         VerticalContentAlignment="Center"
                         Foreground="#212121"/>
            </Grid>
        </Border>

        <!-- Кнопки -->
        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Row 0: тригонометрические функции -->
            <Button Content="sin"
        Grid.Row="0"
        Grid.Column="0"
        Style="{StaticResource SpecialButtonStyle}"
        Command="{Binding ButtonCommand}"
        CommandParameter="sin"/>

            <Button Content="cos"
        Grid.Row="0"
        Grid.Column="1"
        Style="{StaticResource SpecialButtonStyle}"
        Command="{Binding ButtonCommand}"
        CommandParameter="cos"/>

            <Button Content="tan"
        Grid.Row="0"
        Grid.Column="2"
        Style="{StaticResource SpecialButtonStyle}"
        Command="{Binding ButtonCommand}"
        CommandParameter="tan"/>

            <Button Content="cot"
        Grid.Row="0"
        Grid.Column="3"
        Style="{StaticResource SpecialButtonStyle}"
        Command="{Binding ButtonCommand}"
        CommandParameter="cot"/>
            <Button Content="MC"
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource MemoryButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="MC"/>

            <Button Content="MR"
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource MemoryButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="MR"/>

            <Button Content="M+"
                    Grid.Row="1"
                    Grid.Column="2"
                    Style="{StaticResource MemoryButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="M+"/>

            <Button Content="%"
                    Grid.Row="1"
                    Grid.Column="3"
                    Style="{StaticResource OperatorButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="%"/>

            <!-- Row 2 -->
            <Button Content="CE"
                    Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource ClearButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="CE"/>

            <Button Content="C"
                    Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource ClearButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="C"/>

            <Button Content="←"
                    Grid.Row="2"
                    Grid.Column="2"
                    Style="{StaticResource ClearButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="←"/>

            <Button Content="÷"
                    Grid.Row="2"
                    Grid.Column="3"
                    Style="{StaticResource OperatorButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="÷"/>

            <!-- Row 2 -->
            <Button Content="7"
                    Grid.Row="3"
                    Grid.Column="0"
                    Style="{StaticResource DigitButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="7"/>

            <Button Content="8"
                    Grid.Row="3"
                    Grid.Column="1"
                    Style="{StaticResource DigitButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="8"/>

            <Button Content="9"
                    Grid.Row="3"
                    Grid.Column="2"
                    Style="{StaticResource DigitButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="9"/>

            <Button Content="×"
                    Grid.Row="3"
                    Grid.Column="3"
                    Style="{StaticResource OperatorButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="×"/>

            <!-- Row 4 -->
            <Button Content="4"
                    Grid.Row="4"
                    Grid.Column="0"
                    Style="{StaticResource DigitButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="4"/>

            <Button Content="5"
                    Grid.Row="4"
                    Grid.Column="1"
                    Style="{StaticResource DigitButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="5"/>

            <Button Content="6"
                    Grid.Row="4"
                    Grid.Column="2"
                    Style="{StaticResource DigitButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="6"/>

            <Button Content="-"
                    Grid.Row="4"
                    Grid.Column="3"
                    Style="{StaticResource OperatorButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="-"/>

            <!-- Row 5 -->
            <Button Content="1"
                    Grid.Row="5"
                    Grid.Column="0"
                    Style="{StaticResource DigitButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="1"/>

            <Button Content="2"
                    Grid.Row="5"
                    Grid.Column="1"
                    Style="{StaticResource DigitButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="2"/>

            <Button Content="3"
                    Grid.Row="5"
                    Grid.Column="2"
                    Style="{StaticResource DigitButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="3"/>

            <Button Content="+"
                    Grid.Row="5"
                    Grid.Column="3"
                    Style="{StaticResource OperatorButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="+"/>

            <!-- Row 6 -->
            <Button Content="√"
                    Grid.Row="6"
                    Grid.Column="0"
                    Style="{StaticResource SpecialButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="√"/>

            <Button Content="0"
                    Grid.Row="6"
                    Grid.Column="1"
                    Style="{StaticResource DigitButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="0"/>

            <Button Content="x²"
                    Grid.Row="6"
                    Grid.Column="2"
                    Style="{StaticResource SpecialButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="x²"/>

            <Button Content="="
                    Grid.Row="6"
                    Grid.Column="3"
                    Style="{StaticResource EqualsButtonStyle}"
                    Command="{Binding ButtonCommand}"
                    CommandParameter="="/>

        </Grid>
    </Grid>
</Window>