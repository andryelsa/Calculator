<Window x:Class="SimpleCalculatorMVVM.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Height="520"
        Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F2F4F8">

    <Grid Margin="20">

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Image Width="80"
                   Height="80"
                   Source="Resources/Images/calculator.png"
                   Margin="0,0,0,10"/>

            <TextBlock Text="Simple Calculator MVVM"
                       FontSize="22"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Приложение-калькулятор для выполнения арифметических и дополнительных математических операций."
                       FontSize="14"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Поддерживаемые функции:"
                       FontWeight="Bold"
                       FontSize="14"
                       TextAlignment="Center"
                       Margin="0,0,0,5"/>

            <TextBlock Text="• Сложение, вычитание, умножение и деление&#10;• Проценты и смена знака&#10;• Квадрат и квадратный корень&#10;• Работа с памятью (MC, MR, M+)&#10;• Тригонометрические функции: sin, cos, tan, cot"
                       FontSize="12"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"/>

            <TextBlock Text="Разработано на языке C# с использованием технологии WPF и архитектурного шаблона MVVM."
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

            <Button Content="OK"
                    Width="100"
                    Height="35"
                    Click="OkButton_Click"/>

        </StackPanel>

    </Grid>

</Window>